@page "/users"
@rendermode InteractiveServer


@inject LibraryService Library

<PageTitle>User Management</PageTitle>

<h3>User Management</h3>

<!-- Add User Form -->
<div class="card mb-4 p-3 bg-light">
    <h4>Add New User</h4>
    <div class="row g-3">
        <div class="col-md-10">
            <input class="form-control" @value="newName" @oninput="(e) => newName = e.Value?.ToString() ?? string.Empty" placeholder="User Name" />
        </div>
        <div class="col-md-2">
            <button class="btn btn-primary w-100" @onclick="AddUser">Add User</button>
        </div>
    </div>
</div>

<!-- Users List Table -->
<h4>Library Users</h4>
@if (Library.Users.Count == 0)
{
    <p><em>No users found in the system.</em></p>
}
else
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Library.Users)
            {
                <tr>
                    <td>@user.Id</td>
                    <td>@user.Name</td>
                    <td>
                        <button class="btn btn-danger btn-sm" @onclick="() => DeleteUser(user.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private string newName = string.Empty;

    private void AddUser()
    {
        if (!string.IsNullOrWhiteSpace(newName))
        {
            var user = new User
            {
                Name = newName
            };

            Library.AddUser(user);

            // Reset form field
            newName = string.Empty;
        }
    }

    private void DeleteUser(int id)
    {
        Library.DeleteUser(id);
    }
}