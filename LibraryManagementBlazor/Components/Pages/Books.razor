@page "/books"
@rendermode InteractiveServer


@inject LibraryService Library

<PageTitle>Book Management</PageTitle>

<h3>Book Management</h3>

<!-- Add Book Form -->
<div class="card mb-4 p-3 bg-light">
    <h4>Add New Book</h4>
    <div class="row g-3">
        <div class="col-md-5">
            <input class="form-control" @value="newTitle" @oninput="(e) => newTitle = e.Value?.ToString() ?? string.Empty" placeholder="Book Title" />
        </div>
        <div class="col-md-5">
            <input class="form-control" @value="newAuthor" @oninput="(e) => newAuthor = e.Value?.ToString() ?? string.Empty" placeholder="Author Name" />
        </div>
        <div class="col-md-2">
            <button class="btn btn-primary w-100" @onclick="AddBook">Add Book</button>
        </div>
    </div>
</div>

<!-- Books List Table -->
<h4>Library Books</h4>
@if (Library.Books.Count == 0)
{
    <p><em>No books found in the library.</em></p>
}
else
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>ID</th>
                <th>Title</th>
                <th>Author</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Library.Books)
            {
                <tr>
                    <td>@book.Id</td>
                    <td>@book.Title</td>
                    <td>@book.Author</td>
                    <td>
                        <button class="btn btn-danger btn-sm" @onclick="() => DeleteBook(book.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private string newTitle = string.Empty;
    private string newAuthor = string.Empty;

    private void AddBook()
    {
        if (!string.IsNullOrWhiteSpace(newTitle) && !string.IsNullOrWhiteSpace(newAuthor))
        {
            var book = new Book
            {
                Title = newTitle,
                Author = newAuthor
            };

            Library.AddBook(book);

            // Reset form fields
            newTitle = string.Empty;
            newAuthor = string.Empty;
        }
    }

    private void DeleteBook(int id)
    {
        Library.DeleteBook(id);
    }
}